{
  "name": "emberx",
  "type": "module",
  "version": "0.5.0",
  "private": true,
  "author": "Izel Nakri",
  "description": "Explicitly resolvable, build-system-free Ember.js for SPAs",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "deno": ">=2.9.0"
  },
  "volta": {
    "node": "24.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izelnakri/emberx.git"
  },
  "workspaces": [
    "packages/@emberx/*",
    "examples/*"
  ],
  "scripts": {
    "bench": "deno run --allow-all scripts/check-benchmarks.ts --print",
    "bench:check": "deno run --allow-all scripts/check-benchmarks.ts",
    "bench:compare": "deno run --allow-all scripts/check-benchmarks.ts --base",
    "bench:update": "deno run --allow-all scripts/check-benchmarks.ts --save",
    "build": "deno run -A build.ts",
    "changelog:latest": "git-cliff --latest --strip all",
    "changelog:preview": "git-cliff --unreleased",
    "changelog:update": "git-cliff --unreleased --prepend CHANGELOG.md",
    "clean": "rm -rf packages/@emberx/*/dist dist tmp .tmp",
    "dev": "esbuild examples/basic.bundle=examples/basic/index.ts examples/blog.bundle=examples/blog/index.ts --bundle --format=esm --target=es2022 --sourcemap=inline --outdir=public --servedir=public --serve=1234 --serve-fallback=public/index.html --watch",
    "format": "prettier --check . \"!CHANGELOG.md\" \"!package-lock.json\" \"!packages/@emberx/vendor/**\"",
    "format:fix": "prettier --write . \"!CHANGELOG.md\" \"!package-lock.json\" \"!packages/@emberx/vendor/**\"",
    "lint": "deno lint --rules-exclude=ban-ts-comment,no-explicit-any,no-window,no-window-prefix,require-await --ignore=packages/@emberx/vendor/",
    "test": "npm run test:node && npm run test:deno && npm run test:browser",
    "test:browser": "qunitx test/index.ts",
    "test:browser:dev": "qunitx test/index.ts --watch",
    "test:coverage": "qunitx test/index.ts --coverage=lcov,html",
    "test:deno": "deno test --no-check --allow-read --allow-env --preload test/setup-dom.js test/node.ts",
    "test:doctests": "deno test --doc --parallel --no-check --allow-read --allow-env --preload test/setup-dom.js README.md packages/@emberx/*/README.md packages/@emberx/*/src",
    "test:node": "node --import ./scripts/register.ts --import ./test/setup-dom.js --test test/node.ts",
    "test:release": "bash scripts/test-release.sh",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "vendor": "deno run -A scripts/build-emberx-vendor.ts"
  },
  "devDependencies": {
    "@glimmer/component": "2.1.1",
    "@memoria/model": "0.0.33",
    "@memoria/server": "0.0.33",
    "ember-source": "7.3.1",
    "esbuild": "^0.28.2",
    "git-cliff": "^2.14.2",
    "jsdom": "30.1.3",
    "location-bar": "3.0.1",
    "prettier": "^3.9.9",
    "qunit-dom": "^3.6.0",
    "qunitx": "^1.4.0",
    "qunitx-cli": "^0.39.0",
    "rsvp": "^4.8.5",
    "typescript": "^7.0.2"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "prettier": {
    "printWidth": 120,
    "singleQuote": true
  },
  "qunitx": {
    "output": "tmp",
    "timeout": 20000,
    "failFast": false,
    "port": 1234,
    "htmlPaths": [
      "test/index.html"
    ],
    "junit": "tmp/junit.xml"
  },
  "allowScripts": {
    "esbuild": false,
    "qunitx-cli": false
  }
}
