{
  "name": "emberx",
  "type": "module",
  "version": "0.0.14",
  "private": true,
  "author": "Izel Nakri",
  "description": "Explicitly resolvable, build-system-free Ember.js for SPAs",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "deno": ">=2.9.0"
  },
  "volta": {
    "node": "24.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izelnakri/emberx.git"
  },
  "workspaces": [
    "packages/@emberx/*",
    "examples/*"
  ],
  "scripts": {
    "bench": "node benches/index.js",
    "bench:check": "node benches/index.js --check",
    "bench:compare": "node benches/compare.js",
    "bench:update": "node benches/index.js --save",
    "build": "node scripts/build.js",
    "build:dev": "ENVIRONMENT=development node scripts/build.js",
    "changelog:latest": "git-cliff --latest --strip all",
    "changelog:preview": "git-cliff --unreleased",
    "changelog:update": "git-cliff --unreleased --prepend CHANGELOG.md",
    "clean": "node scripts/clean.js",
    "dev": "node scripts/dev.js",
    "format": "prettier --check . \"!CHANGELOG.md\" \"!package-lock.json\" \"!packages/@emberx/router/src/vendor/**\"",
    "format:fix": "prettier --write . \"!CHANGELOG.md\" \"!package-lock.json\" \"!packages/@emberx/router/src/vendor/**\"",
    "lint": "deno lint --rules-exclude=ban-ts-comment,no-explicit-any,no-sloppy-imports,no-window,no-window-prefix,require-await --ignore=packages/@emberx/router/src/vendor/",
    "test": "npm run build:dev && npm run test:node && npm run test:browser",
    "test:browser": "qunitx test/index.ts",
    "test:browser:dev": "qunitx test/index.ts --watch",
    "test:coverage": "qunitx test/index.ts --coverage=lcov,html",
    "test:node": "node scripts/test-node.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@memserver/model": "2.5.3",
    "@memserver/response": "2.5.3",
    "@memserver/server": "2.5.3",
    "esbuild": "^0.28.2",
    "git-cliff": "^2.14.2",
    "prettier": "^3.9.9",
    "qunit-dom": "^3.6.0",
    "qunitx": "^1.3.1",
    "qunitx-cli": "^0.38.0",
    "rsvp": "^4.8.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "pretender": "3.4.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "prettier": {
    "printWidth": 110,
    "singleQuote": true
  },
  "qunitx": {
    "output": "tmp",
    "timeout": 20000,
    "failFast": false,
    "port": 1234,
    "htmlPaths": [
      "test/index.html"
    ],
    "junit": "tmp/junit.xml"
  },
  "allowScripts": {
    "esbuild": false,
    "qunitx-cli": false
  }
}
