{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    /* Relative imports name the file they import, .ts included, which is what
       node and Deno need to run a module without a bundler. */
    "allowImportingTsExtensions": true,

    /* emberx compiles templates at runtime and ships plain ESM; esbuild does the
       emitting, so tsc is only ever used for checking and for .d.ts output. */
    "noEmit": true,
    "isolatedModules": true,
    /* Only TypeScript that node can strip, leaving JavaScript: no parameter
       properties, enums or namespaces, and types imported with `import type`.
       Node 24 runs such files as they are (TODO, running without a build). */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,

    /* Routes, components and helpers use standard decorators, which Deno runs
       as they are: `@tracked accessor count`, `@action`, `@service`. Class
       fields have the standard semantics, ES2022's default. */

    "strict": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "noImplicitReturns": false,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "newLine": "lf",

    /* No ambient @types packages. Every package source file is browser-targeted,
       so DOM comes from `lib` above. Node-only code lives in scripts/ and
       benches/, which this project does not type-check. Ember's types come with
       the @emberx/vendor modules that use them. */
    "types": []
  },
  "include": ["packages/@emberx/*/src/**/*.ts"],
  "exclude": ["node_modules", "tmp", "dist", "**/dist/**"]
}
